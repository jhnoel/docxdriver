{
  "version": 1,
  "scope": "Bounded formatting contract, not full Word rendering parity.",
  "semantics": {
    "omitted": "Leave direct OOXML untouched.",
    "false": "Write an explicit off override (baseline for superscript/subscript).",
    "clear": "Remove the named direct property and inherit styles/defaults; clear wins over set.",
    "revisions": "Text/paragraph formatting is tracked, including in direct plans."
  },
  "capabilities": [
    {
      "id": "bold",
      "read": "supported",
      "html_authoring": "supported",
      "typed_edit": "supported",
      "python_repl": "exposed",
      "note": "Bounded direct property; false explicitly overrides, clear removes the direct setting.",
      "operation": "format_text",
      "fields": [
        "bold"
      ],
      "html_example": "<p><span style=\"font-weight:bold\">sample text</span></p>",
      "read_contains": "<b>"
    },
    {
      "id": "italic",
      "read": "supported",
      "html_authoring": "supported",
      "typed_edit": "supported",
